// OpenCode 2 (paquet « @opencode/cli ») : règles de permission d'exemple, à poser à la racine du projet.
// Les mêmes que dans le settings.json de Claude Code. Adaptez-les : à l'exercice 2, ajoutez en « deny »
// les fichiers que le scan a trouvés ; à l'exercice 3, ajoutez { "action": "edit", "resource": "*tests/*", "effect": "deny" }.
// La dernière règle qui correspond l'emporte : les règles générales "*" d'abord, les exceptions ensuite.
// Les motifs commencent par * parce que l'agent donne souvent un chemin complet (/chemin/du/projet/.env).
{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*secrets/*", "effect": "deny" },
    { "action": "read", "resource": "*config/credentials.*", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "npm test*", "effect": "allow" },
    { "action": "shell", "resource": "npm run lint*", "effect": "allow" },
    { "action": "shell", "resource": "npm run build", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "allow" },
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "curl *", "effect": "deny" }
  ]
}
