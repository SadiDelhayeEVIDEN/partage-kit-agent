{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(npm test *)",
      "Bash(npm run lint *)",
      "Bash(npm run build)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "WebFetch(domain:developer.mozilla.org)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npm install *)",
      "Edit(./package.json)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./secrets/**)",
      "Read(./config/credentials.*)",
      "Bash(git push --force *)",
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s %s\\n' \"$(date '+%F %T')\" \"$(cat)\" >> \"$CLAUDE_PROJECT_DIR/.claude/journal-commandes.log\""
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s %s\\n' \"$(date '+%F %T')\" \"$(cat)\" >> \"$CLAUDE_PROJECT_DIR/.claude/journal-skills.log\""
          }
        ]
      }
    ]
  }
}
